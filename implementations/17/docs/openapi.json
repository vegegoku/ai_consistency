{
  "openapi": "3.1.0",
  "info": {
    "title": "Payment Processing Backend",
    "version": "1.0.0",
    "description": "Synchronous internal JOD transfers. JSON and XML share one command and transaction."
  },
  "servers": [
    {
      "url": "https://localhost:8443"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
