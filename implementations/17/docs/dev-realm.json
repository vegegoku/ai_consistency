{
  "realm": "payments",
  "enabled": true,
  "sslRequired": "none",
  "clientScopes": [
    {
      "name": "payments:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "payments:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "accounts:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "payments:admin",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "payment-cli",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "defaultClientScopes": [
        "payments:write",
        "payments:read",
        "accounts:read"
      ],
      "protocolMappers": [
        {
          "name": "payments-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "payments",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "id",
            "claim.name": "sub",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "payment-ops",
      "enabled": true,
      "publicClient": false,
      "secret": "local-demo-only-change-me",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "defaultClientScopes": [
        "payments:admin"
      ],
      "protocolMappers": [
        {
          "name": "payments-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "payments",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "id",
            "claim.name": "sub",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "alice",
      "enabled": true,
      "firstName": "alice",
      "lastName": "Demo",
      "email": "alice@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "local-demo-only-change-me",
          "temporary": false
        }
      ]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "bob",
      "enabled": true,
      "firstName": "bob",
      "lastName": "Demo",
      "email": "bob@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "local-demo-only-change-me",
          "temporary": false
        }
      ]
    }
  ]
}
