    "/api/v1/operations/reconciliation": {
      "get": {
        "operationId": "reconcile",
        "summary": "Repeatable-read reconciliation; scope operations:read only",
        "responses": {
          "200": {
            "description": "Opening baseline and balanced ledger integrity report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "consistent": {
                      "type": "boolean"
                    },
                    "paymentIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "accountIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "checkedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "consistent": {
                      "type": "boolean"
                    },
                    "paymentIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "accountIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "checkedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "MALFORMED_MESSAGE, VALIDATION_FAILED, or TLS_REQUIRED",
