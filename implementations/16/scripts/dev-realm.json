{
  "realm": "payments",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "payment-service",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "defaultClientScopes": [
        "payments:write",
        "payments:read",
        "accounts:read"
      ],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "payment-service",
            "access.token.claim": "true"
          }
        },
        {
          "name": "customer",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "customer_id",
            "claim.name": "customer_id",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "payments:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "payments:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "accounts:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "attributes": {
        "customer_id": [
          "C1"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "alice-local-only",
          "temporary": false
        }
      ]
    }
  ]
}
