{
  "realm": "payments",
  "enabled": true,
  "sslRequired": "none",
  "clientScopes": [
    {
      "name": "payments:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "payments:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "accounts:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "payments:admin",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "payments-local",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "defaultClientScopes": [
        "payments:write",
        "payments:read",
        "accounts:read",
        "payments:admin"
      ],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "payments-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "dev-alice",
      "username": "alice",
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Developer",
      "email": "alice@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice-local-only",
          "temporary": false
        }
      ]
    },
    {
      "id": "dev-bob",
      "username": "bob",
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Developer",
      "email": "bob@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob-local-only",
          "temporary": false
        }
      ]
    }
  ]
}
